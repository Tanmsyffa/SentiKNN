# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Keep browser synchronization disabled. Database writes belong in an authenticated server route.
NEXT_PUBLIC_SUPABASE_BROWSER_SYNC_ENABLED=false
# Server-only. Add to local backend environment and Vercel Environment Variables.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
